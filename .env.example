# Docker 部署配置（复制为 .env）
# 运行镜像名。本仓库不发布公共镜像，首次安装时由 install.sh 本地构建（见 README）。
SECOPS_IMAGE=secops
SECOPS_TAG=latest
POSTGRES_USER=secops
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=secops

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SECOPS_LLM_PROVIDER=
SECOPS_LLM_MODEL=
SECOPS_LLM_BASE_URL=
SECOPS_LLM_PROXY=
